@@ -58,7 +58,11 @@ class GPUTask:
     hparam_overrides: str
 
 def run(task: GPUTask):
-    gpu_ids_str = ",".join(map(str, task.gpu_ids))
+    # Local change (olmo-rlvr-side-effects): task.gpu_ids index the devices this process can see. Map them back through
+    # the caller's CUDA_VISIBLE_DEVICES; otherwise a run started on GPUs 2,3 launches its tasks on GPUs 0,1.
+    visible = os.environ.get("CUDA_VISIBLE_DEVICES")
+    ids = visible.split(",") if visible else None
+    gpu_ids_str = ",".join(ids[i] if ids else str(i) for i in task.gpu_ids)
     print(f"Running {task.task_name} on GPUs {gpu_ids_str}.")
     command = task.script_format.format(gpu_id=gpu_ids_str, task_name=task.task_name, hparam_overrides=task.hparam_overrides)
     os.system(command)
