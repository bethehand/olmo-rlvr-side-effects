+def _vllm_memory_kwargs() -> dict:
+    # Local change (olmo-rlvr-side-effects, for 24 GB cards): vLLM memory settings from the environment.
+    # Unset = vLLM's defaults, i.e. upstream behaviour. Sampling is not affected.
+    kw = {}
+    if os.environ.get("SAFETY_EVAL_GPU_MEM"):
+        kw["gpu_memory_utilization"] = float(os.environ["SAFETY_EVAL_GPU_MEM"])
+    if os.environ.get("SAFETY_EVAL_MAX_NUM_SEQS"):
+        kw["max_num_seqs"] = int(os.environ["SAFETY_EVAL_MAX_NUM_SEQS"])
+    return kw
